{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["governing_record","candidate_revision","generated_at","browser","captures"],
  "properties": {
    "governing_record": {"const":"ENG-COI-DIC-001 Revision 1.1"},
