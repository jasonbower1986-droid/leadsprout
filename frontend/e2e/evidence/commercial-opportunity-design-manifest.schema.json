    "browser": {"type":"string","minLength":1},
    "captures": {"type":"array","minItems":6,"items":{"type":"object","required":["file","candidate_revision","route","controlled_state","active_navigation_item","viewport","device_scale_factor","feature_control","scenario","authenticated_role","utc_timestamp","browser","screenshot_sha256","design_baseline","source_render_sha256"],"properties":{"file":{"type":"string"},"candidate_revision":{"pattern":"^[0-9a-f]{40}$"},"route":{"type":"string"},"controlled_state":{"type":"string"},"active_navigation_item":{"enum":["Home","Opportunities"]},"viewport":{"type":"object","required":["width","height"],"properties":{"width":{"type":"integer"},"height":{"type":"integer"}}},"device_scale_factor":{"type":"number"},"feature_control":{"const":"OPPORTUNITY_WORKSPACE_ENABLED=true"},"scenario":{"type":"string"},"authenticated_role":{"type":"string"},"utc_timestamp":{"format":"date-time"},"browser":{"type":"string"},"screenshot_sha256":{"pattern":"^[0-9a-f]{64}$"},"design_baseline":{"const":"WD-CDB-001 Revision 1.1"},"source_render_sha256":{"pattern":"^[0-9a-f]{64}$"}}}}
  }
}
